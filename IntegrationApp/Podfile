  pod 'JustTrackSDKUnityAdsAdapter', :path => '../Adapters/UnityAds'
  pod 'JustTrackSDKFacebookAdapter', :path => '../Adapters/Facebook'
  pod 'JustTrackSDKGoogleOdmAdapter', :path => '../Adapters/GoogleOdm'

  use_frameworks!
